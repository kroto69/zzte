diff --git a/internal/event/alert.go b/internal/event/alert.go
new file mode 100644
index 0000000..9c4d406
--- /dev/null
+++ b/internal/event/alert.go
@@ -0,0 +1,320 @@
+package event
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"sync"
+	"time"
+
+	"github.com/rs/zerolog/log"
+
+	"olt-monitor/internal/cache"
+)
+
+// Alert: satu notifikasi down yang sudah lolos anti-spam.
+// Disimpan di Redis dan diekspos via GET /api/v1/alerts agar frontend
+// (atau integrasi lain) bisa menampilkannya. Tanpa ketergantungan ke
+// layanan pihak ketiga — backend murni.
+type Alert struct {
+	ID        string    `json:"id"`
+	OLTID     string    `json:"oltId"`
+	Board     int       `json:"board"`
+	Pon       int       `json:"pon"`
+	OnuID     int       `json:"onuId"` // 0 = mass-down satu PON port
+	Kind      string    `json:"kind"`  // "down" | "mass-down"
+	Cause     string    `json:"cause"`
+	Count     int       `json:"count,omitempty"`
+	Severity  string    `json:"severity"` // critical | warning | info
+	Message   string    `json:"message"`
+	CreatedAt time.Time `json:"createdAt"`
+}
+
+// AlertConfig konfigurasi mesin alert.
+type AlertConfig struct {
+	Cooldown      time.Duration // per ONU, default 60m
+	AggWindow     time.Duration // default 90s
+	MassThreshold int           // default 5
+}
+
+// VerifyFunc men-verify ulang apakah sebuah event down masih valid.
+// Dipanggil di momen batch-flush, sebelum alert diterbitkan.
+// Return true = ONU masih down (alert dilanjutkan), false = ONU sudah
+// kembali online (alert dibuang — kemungkinan flapping syslog).
+// Jalur event-driven tetap tidak membebani OLT: verifikasi ini hanya
+// satu SNMP GET terarah per ONU yang akan di-alert, bukan polling.
+// Kesalahan SNMP -> trust syslog (return true).
+type VerifyFunc func(ev Event) bool
+
+// Engine: subscriber bus yang mengubah event down menjadi Alert dengan
+// anti-spam (prinsip: jangan banjiri teknisi):
+//  1. Agregasi: down dikumpulkan AggWindow; satu PON port >= MassThreshold
+//     dalam window -> SATU alert mass-down, bukan N alert.
+//  2. Verifikasi ulang: di momen flush, setiap calon alert di-verify via
+//     SNMP GET status ONU; yang sudah kembali online dibuang (anti false
+//     alarm saat ONU flapping). Aktif bila SetVerifier dipasang.
+//  3. Cooldown: 1 ONU max 1 alert down per Cooldown.
+//  4. Severity: mass-down=critical, los/unknown=warning, power=info
+//     (dying-gasp tetap tercatat, tapi tidak dianggap darurat).
+type Engine struct {
+	cfg   AlertConfig
+	cache *cache.RedisCache
+	in    chan Event
+
+	verify VerifyFunc // nil = tanpa verifikasi ulang (perilaku lama)
+
+	// onEmit dipanggil setiap alert diterbitkan; dipakai unit test
+	// untuk menangkap alert tanpa Redis. Nil di produksi.
+	onEmit func(Alert)
+
+	mu       sync.Mutex
+	buf      map[string][]Event // ponKey -> downs dalam window
+	flushAt  time.Time
+	lastSent map[string]time.Time
+
+	done chan struct{}
+	wg   sync.WaitGroup
+}
+
+// SetVerifier memasang fungsi verifikasi ulang yang dipanggil tepat
+// sebelum alert diterbitkan. Boleh nil untuk menonaktifkan.
+func (e *Engine) SetVerifier(v VerifyFunc) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.verify = v
+}
+
+func NewEngine(cfg AlertConfig, c *cache.RedisCache) *Engine {
+	if cfg.Cooldown <= 0 {
+		cfg.Cooldown = 60 * time.Minute
+	}
+	if cfg.AggWindow <= 0 {
+		cfg.AggWindow = 90 * time.Second
+	}
+	if cfg.MassThreshold <= 0 {
+		cfg.MassThreshold = 5
+	}
+	return &Engine{
+		cfg:      cfg,
+		cache:    c,
+		in:       make(chan Event, 512),
+		buf:      make(map[string][]Event),
+		lastSent: make(map[string]time.Time),
+		done:     make(chan struct{}),
+	}
+}
+
+// Handle penuhi signature subscriber Bus. Cepat: hanya enqueue.
+func (e *Engine) Handle(ev Event) {
+	if ev.Kind != KindDown {
+		return
+	}
+	select {
+	case e.in <- ev:
+	default:
+		log.Warn().Msg("Alert engine penuh, event dibuang")
+	}
+}
+
+func (e *Engine) Start() {
+	e.wg.Add(1)
+	go e.loop()
+}
+
+func (e *Engine) Stop() {
+	close(e.done)
+	e.wg.Wait()
+}
+
+func (e *Engine) loop() {
+	defer e.wg.Done()
+	tick := time.NewTicker(10 * time.Second)
+	defer tick.Stop()
+	for {
+		select {
+		case <-e.done:
+			e.flushAll()
+			return
+		case ev := <-e.in:
+			e.add(ev)
+		case <-tick.C:
+			e.flushExpired()
+		}
+	}
+}
+
+func (e *Engine) add(ev Event) {
+	key := ev.ponKey()
+	var flushNow bool
+	e.mu.Lock()
+	e.buf[key] = append(e.buf[key], ev)
+	if e.flushAt.IsZero() {
+		e.flushAt = time.Now().Add(e.cfg.AggWindow)
+	}
+	flushNow = len(e.buf[key]) >= e.cfg.MassThreshold
+	e.mu.Unlock()
+	if flushNow {
+		e.flushKey(key)
+	}
+}
+
+func (e *Engine) flushExpired() {
+	e.mu.Lock()
+	if e.flushAt.IsZero() || time.Now().Before(e.flushAt) {
+		e.mu.Unlock()
+		return
+	}
+	keys := make([]string, 0, len(e.buf))
+	for key := range e.buf {
+		keys = append(keys, key)
+	}
+	e.mu.Unlock()
+	for _, key := range keys {
+		e.flushKey(key)
+	}
+	e.mu.Lock()
+	e.flushAt = time.Time{}
+	e.mu.Unlock()
+}
+
+func (e *Engine) flushAll() {
+	e.mu.Lock()
+	keys := make([]string, 0, len(e.buf))
+	for key := range e.buf {
+		keys = append(keys, key)
+	}
+	e.mu.Unlock()
+	for _, key := range keys {
+		e.flushKey(key)
+	}
+}
+
+// flushKey menarik buffer satu PON port, memverifikasi ulang status ONU
+// yang masih down, lalu menerbitkan alert. Verifikasi dilakukan di luar
+// lock (ada I/O jaringan) agar intake event tidak terhambat.
+func (e *Engine) flushKey(key string) {
+	e.mu.Lock()
+	evs := e.buf[key]
+	delete(e.buf, key)
+	e.mu.Unlock()
+
+	if len(evs) == 0 {
+		return
+	}
+	evs = e.reverify(evs)
+	if len(evs) == 0 {
+		log.Debug().Str("pon", key).Msg("Alert dibuang: semua ONU sudah kembali online")
+		return
+	}
+	if len(evs) >= e.cfg.MassThreshold {
+		e0 := evs[0]
+		e.emit(Alert{
+			OLTID:    e0.OLTID,
+			Board:    e0.Board,
+			Pon:      e0.Pon,
+			Kind:     "mass-down",
+			Cause:    CauseMass,
+			Count:    len(evs),
+			Severity: "critical",
+			Message: "MASS DOWN: " + itoa(len(evs)) + " ONU down di " +
+				e0.OLTID + " PON " + itoa(e0.Board) + "/" + itoa(e0.Pon) +
+				". Kemungkinan feeder/splitter/OLT — cek infrastruktur dulu.",
+		})
+		e.mu.Lock()
+		now := time.Now()
+		for _, ev := range evs {
+			e.lastSent[ev.dedupKey()] = now
+		}
+		e.mu.Unlock()
+		return
+	}
+	e.emitSingles(evs)
+}
+
+// reverify membuang event yang ONU-nya sudah kembali online di momen
+// flush. Tanpa verifier (nil), semua event dianggap masih valid.
+func (e *Engine) reverify(evs []Event) []Event {
+	if e == nil || len(evs) == 0 {
+		return evs
+	}
+	verify := e.verify
+	if verify == nil {
+		return evs
+	}
+	kept := evs[:0]
+	for _, ev := range evs {
+		if verify(ev) {
+			kept = append(kept, ev)
+			continue
+		}
+		log.Debug().
+			Str("olt", ev.OLTID).
+			Int("board", ev.Board).Int("pon", ev.Pon).Int("onu", ev.OnuID).
+			Msg("Alert dibuang: ONU kembali online sebelum flush")
+	}
+	return kept
+}
+
+// emitSingles menerbitkan alert per-ONU dengan cooldown.
+func (e *Engine) emitSingles(evs []Event) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	now := time.Now()
+	for _, ev := range evs {
+		dk := ev.dedupKey()
+		if last, ok := e.lastSent[dk]; ok && now.Sub(last) < e.cfg.Cooldown {
+			continue // cooldown
+		}
+		e.lastSent[dk] = now
+		severity := "warning"
+		causeMsg := "penyebab belum diketahui"
+		switch ev.Cause {
+		case CausePower:
+			severity = "info"
+			causeMsg = "kemungkinan listrik/adaptor di sisi pelanggan"
+		case CauseLOS:
+			causeMsg = "sinyal optik hilang — cek fiber/konektor"
+		}
+		e.emit(Alert{
+			OLTID:    ev.OLTID,
+			Board:    ev.Board,
+			Pon:      ev.Pon,
+			OnuID:    ev.OnuID,
+			Kind:     "down",
+			Cause:    ev.Cause,
+			Severity: severity,
+			Message: "DOWN: " + ev.OLTID + " " + itoa(ev.Board) + "/" +
+				itoa(ev.Pon) + ":" + itoa(ev.OnuID) + " — " + causeMsg,
+		})
+	}
+}
+
+func (e *Engine) emit(a Alert) {
+	a.ID = newID()
+	a.CreatedAt = time.Now()
+	if e.onEmit != nil {
+		e.onEmit(a)
+	}
+	if e.cache == nil {
+		return
+	}
+	data, err := json.Marshal(a)
+	if err != nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	if err := e.cache.AppendAlert(ctx, data); err != nil {
+		log.Warn().Err(err).Msg("Append alert gagal")
+	}
+	if err := e.cache.PublishAlert(ctx, data); err != nil {
+		log.Warn().Err(err).Msg("Publish alert gagal")
+	}
+}
+
+func newID() string {
+	var b [8]byte
+	_, _ = rand.Read(b[:])
+	return hex.EncodeToString(b[:])
+}
diff --git a/internal/event/alert_test.go b/internal/event/alert_test.go
new file mode 100644
index 0000000..679e5c8
--- /dev/null
+++ b/internal/event/alert_test.go
@@ -0,0 +1,118 @@
+package event
+
+import (
+	"testing"
+	"time"
+)
+
+func downEv(olt string, board, pon, onu int, cause string) Event {
+	return Event{
+		OLTID:      olt,
+		Board:      board,
+		Pon:        pon,
+		OnuID:      onu,
+		Kind:       KindDown,
+		Cause:      cause,
+		ReceivedAt: time.Now(),
+	}
+}
+
+func testEngine() (*Engine, *[]Alert) {
+	var got []Alert
+	e := NewEngine(AlertConfig{
+		Cooldown:      60 * time.Minute,
+		AggWindow:     90 * time.Second,
+		MassThreshold: 3,
+	}, nil)
+	e.onEmit = func(a Alert) { got = append(got, a) }
+	return e, &got
+}
+
+// Tanpa verifier: perilaku lama — semua event jadi alert.
+func TestFlushKeyTanpaVerifier(t *testing.T) {
+	e, got := testEngine()
+	e.add(downEv("olt1", 1, 1, 5, CauseLOS))
+	e.add(downEv("olt1", 1, 1, 6, CausePower))
+	e.flushKey("olt1/1/1")
+	if len(*got) != 2 {
+		t.Fatalf("mau 2 alert, dapat %d", len(*got))
+	}
+}
+
+// Verifier bilang onu 5 sudah online -> alert-nya dibuang, onu 6 tetap.
+func TestReverifyBuangYangSudahOnline(t *testing.T) {
+	e, got := testEngine()
+	e.SetVerifier(func(ev Event) bool {
+		return ev.OnuID != 5 // 5 sudah kembali online
+	})
+	e.add(downEv("olt1", 1, 1, 5, CauseLOS))
+	e.add(downEv("olt1", 1, 1, 6, CauseLOS))
+	e.flushKey("olt1/1/1")
+	if len(*got) != 1 {
+		t.Fatalf("mau 1 alert, dapat %d", len(*got))
+	}
+	if (*got)[0].OnuID != 6 {
+		t.Fatalf("mau alert untuk onu 6, dapat onu %d", (*got)[0].OnuID)
+	}
+}
+
+// Semua sudah online -> tidak ada alert sama sekali.
+func TestReverifySemuaOnlineTidakAdaAlert(t *testing.T) {
+	e, got := testEngine()
+	e.SetVerifier(func(ev Event) bool { return false })
+	e.add(downEv("olt1", 1, 1, 5, CauseLOS))
+	e.add(downEv("olt1", 1, 1, 6, CauseLOS))
+	e.flushKey("olt1/1/1")
+	if len(*got) != 0 {
+		t.Fatalf("mau 0 alert, dapat %d", len(*got))
+	}
+}
+
+// Mass-down: sebagian kembali online, sisa di bawah threshold ->
+// jadi alert per-ONU untuk yang masih down (bukan mass-down).
+func TestReverifyMassDownTurunJadiSingles(t *testing.T) {
+	e, got := testEngine() // threshold 3
+	e.SetVerifier(func(ev Event) bool {
+		return ev.OnuID <= 2 // 3 dan 4 sudah online
+	})
+	for i := 1; i <= 4; i++ {
+		e.add(downEv("olt1", 1, 1, i, CauseLOS))
+	}
+	e.flushKey("olt1/1/1")
+	if len(*got) != 2 {
+		t.Fatalf("mau 2 alert single, dapat %d", len(*got))
+	}
+	for _, a := range *got {
+		if a.Kind != "down" {
+			t.Fatalf("mau kind=down, dapat %q", a.Kind)
+		}
+	}
+}
+
+// Mass-down asli: semua masih down -> satu alert mass-down.
+// (early flush saat threshold tercapai; tidak perlu flushKey manual)
+func TestReverifyMassDownAsli(t *testing.T) {
+	e, got := testEngine() // threshold 3
+	e.SetVerifier(func(ev Event) bool { return true })
+	for i := 1; i <= 3; i++ {
+		e.add(downEv("olt1", 1, 1, i, CauseLOS))
+	}
+	if len(*got) != 1 {
+		t.Fatalf("mau 1 alert, dapat %d", len(*got))
+	}
+	if (*got)[0].Kind != "mass-down" || (*got)[0].Count != 3 {
+		t.Fatalf("mau mass-down count=3, dapat %+v", (*got)[0])
+	}
+}
+
+// SetVerifier(nil) menonaktifkan verifikasi -> perilaku lama.
+func TestReverifyNilNonaktif(t *testing.T) {
+	e, got := testEngine()
+	e.SetVerifier(func(ev Event) bool { return false })
+	e.SetVerifier(nil)
+	e.add(downEv("olt1", 1, 1, 5, CauseLOS))
+	e.flushKey("olt1/1/1")
+	if len(*got) != 1 {
+		t.Fatalf("mau 1 alert, dapat %d", len(*got))
+	}
+}
diff --git a/internal/event/bus.go b/internal/event/bus.go
new file mode 100644
index 0000000..2c6d7ec
--- /dev/null
+++ b/internal/event/bus.go
@@ -0,0 +1,114 @@
+package event
+
+import (
+	"sync"
+	"time"
+
+	"github.com/rs/zerolog/log"
+)
+
+// dedupWindow: event sama (ONU+jenis) dalam window ini dianggap duplikat.
+// Menangkal: trap ganda dari OLT, duplikat syslog+trap, dan tabrakan dengan poller.
+const dedupWindow = 60 * time.Second
+
+// Bus: fan-out event ke subscriber dengan dedup.
+//
+// Desain: SATU goroutine worker membaca channel buffer. Subscriber dipanggil
+// sekuensial — jadi subscriber WAJIB cepat & non-blocking (tulis Redis OK;
+// kerja berat TIDAK OK di sini — alert engine punya worker+antrean sendiri).
+// Bila buffer penuh, event baru dibuang (lebih baik kehilangan 1 event
+// daripada OOM; poller tetap jadi jaring pengaman via reconcile).
+type Bus struct {
+	in   chan Event
+	subs []func(Event)
+
+	mu   sync.Mutex
+	seen map[string]time.Time
+
+	done chan struct{}
+	wg   sync.WaitGroup
+}
+
+// NewBus buat bus dengan buffer sebesar size.
+func NewBus(size int) *Bus {
+	if size <= 0 {
+		size = 1024
+	}
+	return &Bus{
+		in:   make(chan Event, size),
+		seen: make(map[string]time.Time),
+		done: make(chan struct{}),
+	}
+}
+
+// Subscribe daftarkan penerima event. Panggil sebelum Start.
+func (b *Bus) Subscribe(fn func(Event)) {
+	b.subs = append(b.subs, fn)
+}
+
+// Publish kirim event. Return false bila buffer penuh (event dibuang).
+func (b *Bus) Publish(ev Event) bool {
+	select {
+	case b.in <- ev:
+		return true
+	default:
+		log.Warn().Str("olt", ev.OLTID).Msg("Event bus penuh, event dibuang")
+		return false
+	}
+}
+
+// Start jalankan worker. Stop dengan Close.
+func (b *Bus) Start() {
+	b.wg.Add(1)
+	go b.loop()
+}
+
+// Close hentikan worker.
+func (b *Bus) Close() {
+	close(b.done)
+	b.wg.Wait()
+}
+
+func (b *Bus) loop() {
+	defer b.wg.Done()
+	tidy := time.NewTicker(5 * time.Minute)
+	defer tidy.Stop()
+	for {
+		select {
+		case <-b.done:
+			return
+		case ev := <-b.in:
+			if b.dup(ev) {
+				continue
+			}
+			for _, fn := range b.subs {
+				fn(ev)
+			}
+		case <-tidy.C:
+			b.gc()
+		}
+	}
+}
+
+func (b *Bus) dup(ev Event) bool {
+	key := ev.dedupKey()
+	now := time.Now()
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if t, ok := b.seen[key]; ok && now.Sub(t) < dedupWindow {
+		return true
+	}
+	b.seen[key] = now
+	return false
+}
+
+func (b *Bus) gc() {
+	cutoff := time.Now().Add(-2 * dedupWindow)
+	b.mu.Lock()
+	for k, t := range b.seen {
+		if t.Before(cutoff) {
+			delete(b.seen, k)
+		}
+	}
+	b.mu.Unlock()
+}
diff --git a/internal/event/event.go b/internal/event/event.go
new file mode 100644
index 0000000..2e023df
--- /dev/null
+++ b/internal/event/event.go
@@ -0,0 +1,73 @@
+// Package event: jalur event-driven untuk status ONU.
+//
+// Prinsip #1: JANGAN BEBANI OLT. OLT hanya "didorong" mengirim syslog saat ada
+// kejadian (up/down). Tidak ada polling status di jalur ini — OLT tidak pernah
+// ditanya, hanya didengarkan. Beban CPU/memory OLT praktis nol.
+//
+// Prinsip #2: multi-OLT sejak awal. Setiap event membawa OLTID yang di-resolve
+// dari IP pengirim (lihat mapper.go).
+package event
+
+import "time"
+
+// Kind jenis event.
+type Kind string
+
+const (
+	KindUp   Kind = "up"
+	KindDown Kind = "down"
+)
+
+// Cause penyebab down (diklasifikasikan dari alarm ZTE).
+const (
+	CausePower   = "power"   // dying-gasp: adaptor dicabut / listrik padam
+	CauseLOS     = "los"     // sinyal optik hilang: fiber / konektor
+	CauseMass    = "mass"    // bagian dari mass-down satu PON port
+	CauseUnknown = "unknown"
+)
+
+// Event satu kejadian ONU.
+type Event struct {
+	OLTID      string    `json:"oltId"`
+	Board      int       `json:"board"`
+	Pon        int       `json:"pon"`
+	OnuID      int       `json:"onuId"`
+	Kind       Kind      `json:"kind"`
+	Cause      string    `json:"cause"`
+	Count      int       `json:"count,omitempty"` // untuk cause=mass: jumlah ONU
+	Raw        string    `json:"raw,omitempty"`   // baris syslog asli (dipotong)
+	SourceIP   string    `json:"sourceIp,omitempty"`
+	ReceivedAt time.Time `json:"receivedAt"`
+}
+
+// Key untuk dedup: ONU + jenis event.
+func (e Event) dedupKey() string {
+	return e.OLTID + "/" + itoa(e.Board) + "/" + itoa(e.Pon) + ":" + itoa(e.OnuID) + ":" + string(e.Kind)
+}
+
+// PonKey untuk agregasi mass-down.
+func (e Event) ponKey() string {
+	return e.OLTID + "/" + itoa(e.Board) + "/" + itoa(e.Pon)
+}
+
+func itoa(i int) string {
+	if i == 0 {
+		return "0"
+	}
+	neg := i < 0
+	if neg {
+		i = -i
+	}
+	var b [20]byte
+	p := len(b)
+	for i > 0 {
+		p--
+		b[p] = byte('0' + i%10)
+		i /= 10
+	}
+	if neg {
+		p--
+		b[p] = '-'
+	}
+	return string(b[p:])
+}
diff --git a/internal/event/mapper.go b/internal/event/mapper.go
new file mode 100644
index 0000000..15774fc
--- /dev/null
+++ b/internal/event/mapper.go
@@ -0,0 +1,59 @@
+package event
+
+import (
+	"sync"
+
+	"olt-monitor/internal/service"
+)
+
+// Mapper: IP pengirim syslog -> OLTID. Wajib untuk multi-OLT.
+//
+// Urutan resolve:
+//  1. Config eksplisit: event.syslog.sources = { "192.168.1.100": "olt-jkt" }
+//  2. Fallback otomatis: cocokkan dengan host SNMP OLT yang terdaftar
+//     (umumnya syslog dikirim dari IP yang sama dengan IP SNMP OLT).
+type Mapper struct {
+	mu      sync.RWMutex
+	sources map[string]string // ip -> oltID (config)
+
+	manager *service.OLTManager // untuk fallback host SNMP
+}
+
+// NewMapper buat mapper. manager boleh nil (fallback nonaktif).
+func NewMapper(manager *service.OLTManager) *Mapper {
+	return &Mapper{
+		sources: make(map[string]string),
+		manager: manager,
+	}
+}
+
+// SetSources isi/overwrite mapping dari config.
+func (m *Mapper) SetSources(src map[string]string) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for ip, id := range src {
+		m.sources[ip] = id
+	}
+}
+
+// Resolve IP -> OLTID. ok=false bila tidak dikenal.
+func (m *Mapper) Resolve(ip string) (oltID string, ok bool) {
+	if ip == "" {
+		return "", false
+	}
+	m.mu.RLock()
+	id, ok := m.sources[ip]
+	m.mu.RUnlock()
+	if ok {
+		return id, true
+	}
+	// Fallback: samakan dengan host SNMP OLT terdaftar.
+	if m.manager != nil {
+		for _, olt := range m.manager.ListOLTs() {
+			if olt.SNMP.Host == ip {
+				return olt.ID, true
+			}
+		}
+	}
+	return "", false
+}
diff --git a/internal/event/parser.go b/internal/event/parser.go
new file mode 100644
index 0000000..7192e5f
--- /dev/null
+++ b/internal/event/parser.go
@@ -0,0 +1,99 @@
+package event
+
+import (
+	"regexp"
+	"strings"
+)
+
+// Pola syslog ZTE. Format teks bisa beda antar firmware — pola yang tidak
+// dikenal dikembalikan sebagai ok=false agar dicatat untuk kalibrasi,
+// bukan di-drop diam-diam.
+var (
+	// gpon-onu_1/2/3:4, gpon_onu 1/2/3:4, onu 1/2/3:4 ...
+	onuRe = regexp.MustCompile(`(?i)gpon[-_ ]?onu[_ ]?(\d+)/(\d+)/(\d+)[:_/](\d+)`)
+
+	causeRes = []struct {
+		cause string
+		re    *regexp.Regexp
+	}{
+		{CausePower, regexp.MustCompile(`(?i)dying[-_ ]?gasp`)},
+		{CauseLOS, regexp.MustCompile(`(?i)\blos\b|link[-_ ]?lost|\blofi\b|\bsdi\b`)},
+	}
+
+	downRes = []*regexp.Regexp{
+		regexp.MustCompile(`(?i)deregister`),
+		regexp.MustCompile(`(?i)\boff ?line\b`),
+		regexp.MustCompile(`(?i)\bdown\b`),
+	}
+	upRes = []*regexp.Regexp{
+		regexp.MustCompile(`(?i)\bon ?line\b`),
+		regexp.MustCompile(`(?i)register.*success|authorized.*success`),
+		regexp.MustCompile(`(?i)los recovery|ranging.*success`),
+		regexp.MustCompile(`(?i)phase.*working`),
+	}
+
+	// Header syslog "<132>Oct  9 14:00:00 hostname ..." — buang agar regex fokus ke isi.
+	headerRe = regexp.MustCompile(`^<\d+>\S*\s*`)
+)
+
+// Parsed hasil parse satu baris syslog.
+type Parsed struct {
+	Board, Pon, OnuID int
+	Kind              Kind
+	Cause             string
+}
+
+// ParseLine parse satu baris syslog ZTE. ok=false bila tidak dikenali.
+func ParseLine(line string) (p Parsed, ok bool) {
+	line = headerRe.ReplaceAllString(line, "")
+	line = strings.TrimSpace(line)
+	if line == "" {
+		return p, false
+	}
+	m := onuRe.FindStringSubmatch(line)
+	if m == nil {
+		return p, false
+	}
+	p.Board = atoi(m[2])
+	p.Pon = atoi(m[3])
+	p.OnuID = atoi(m[4])
+	// m[1] = shelf, jarang dipakai di ZTE C320 (selalu 1)
+
+	p.Cause = CauseUnknown
+	for _, cr := range causeRes {
+		if cr.re.MatchString(line) {
+			p.Cause = cr.cause
+			break
+		}
+	}
+	for _, re := range upRes {
+		if re.MatchString(line) {
+			p.Kind = KindUp
+			p.Cause = ""
+			return p, true
+		}
+	}
+	for _, re := range downRes {
+		if re.MatchString(line) {
+			p.Kind = KindDown
+			return p, true
+		}
+	}
+	// Alarm dying-gasp/LOS secara definisi = down, walau tanpa kata "down".
+	if p.Cause == CausePower || p.Cause == CauseLOS {
+		p.Kind = KindDown
+		return p, true
+	}
+	return p, false
+}
+
+func atoi(s string) int {
+	n := 0
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			break
+		}
+		n = n*10 + int(c-'0')
+	}
+	return n
+}
diff --git a/internal/event/parser_test.go b/internal/event/parser_test.go
new file mode 100644
index 0000000..667020a
--- /dev/null
+++ b/internal/event/parser_test.go
@@ -0,0 +1,57 @@
+package event
+
+import "testing"
+
+func TestParseLine(t *testing.T) {
+	cases := []struct {
+		line      string
+		board     int
+		pon       int
+		onu       int
+		kind      Kind
+		cause     string
+	}{
+		{
+			`<134>Oct  9 14:00:01 OLT: gpon-onu_1/2/3:4 dying-gasp alarm`,
+			2, 3, 4, KindDown, CausePower,
+		},
+		{
+			`gpon-onu_1/5/8:16 LOS alarm raised`,
+			5, 8, 16, KindDown, CauseLOS,
+		},
+		{
+			`ONU gpon-onu_1/1/1:1 deregistered`,
+			1, 1, 1, KindDown, CauseUnknown,
+		},
+		{
+			`gpon-onu_1/2/3:4 online`,
+			2, 3, 4, KindUp, "",
+		},
+		{
+			`gpon-onu_1/2/3:4 LOS recovery`,
+			2, 3, 4, KindUp, "",
+		},
+		{
+			`some random log line without onu`,
+			0, 0, 0, "", "",
+		},
+	}
+	for i, c := range cases {
+		p, ok := ParseLine(c.line)
+		if c.kind == "" {
+			if ok {
+				t.Errorf("case %d: expected not-ok, got %+v", i, p)
+			}
+			continue
+		}
+		if !ok {
+			t.Errorf("case %d: expected ok, got not-ok for %q", i, c.line)
+			continue
+		}
+		if p.Board != c.board || p.Pon != c.pon || p.OnuID != c.onu ||
+			p.Kind != c.kind || p.Cause != c.cause {
+			t.Errorf("case %d: got %+v, want board=%d pon=%d onu=%d kind=%s cause=%s",
+				i, p, c.board, c.pon, c.onu, c.kind, c.cause)
+		}
+	}
+}
diff --git a/internal/event/sink.go b/internal/event/sink.go
new file mode 100644
index 0000000..4642663
--- /dev/null
+++ b/internal/event/sink.go
@@ -0,0 +1,68 @@
+package event
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	"github.com/rs/zerolog/log"
+
+	"olt-monitor/internal/cache"
+	"olt-monitor/internal/domain"
+)
+
+// Sink: subscriber bus yang menulis event ke Redis.
+//
+// Tiga hal dilakukan per event (semuanya cepat & non-blocking):
+//  1. Patch status ONU di cache list PON (read-modify-write 1 item) —
+//     dashboard yang baca cache langsung lihat status baru tanpa walk SNMP.
+//  2. Publish ke Redis pub/sub "zzte:events" — untuk dashboard realtime (SSE).
+//  3. Append ke event log terbatas (500) — untuk API /events/recent.
+type Sink struct {
+	cache *cache.RedisCache
+}
+
+func NewSink(c *cache.RedisCache) *Sink { return &Sink{cache: c} }
+
+// Handle penuhi signature subscriber Bus.
+func (s *Sink) Handle(ev Event) {
+	if s.cache == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+
+	// 1. patch status di cache list
+	status, code := statusFor(ev)
+	if err := s.cache.PatchONUStatus(ctx, ev.OLTID, ev.Board, ev.Pon, ev.OnuID, status, code); err != nil {
+		log.Debug().Err(err).Msg("Patch status cache gagal (mungkin cache kosong)")
+	}
+	// invalidate detail ONU itu — biar baca berikutnya segar
+	_ = s.cache.InvalidateONUDetail(ctx, ev.OLTID, ev.Board, ev.Pon, ev.OnuID)
+
+	// 2. pub/sub realtime
+	if data, err := json.Marshal(ev); err == nil {
+		if err := s.cache.PublishEvent(ctx, data); err != nil {
+			log.Warn().Err(err).Msg("Publish event gagal")
+		}
+		// 3. event log
+		if err := s.cache.AppendEventLog(ctx, data); err != nil {
+			log.Warn().Err(err).Msg("Append event log gagal")
+		}
+	}
+}
+
+// statusFor samakan kosakata dengan ParseONUStatus (SNMP).
+func statusFor(ev Event) (string, int) {
+	if ev.Kind == KindUp {
+		return "Online", domain.ONUStatusOnline
+	}
+	switch ev.Cause {
+	case CauseLOS:
+		return "LOS", domain.ONUStatusLOS
+	case CausePower:
+		return "DyingGasp", domain.ONUStatusDyingGasp
+	default:
+		return "Offline", domain.ONUStatusOffline
+	}
+}
diff --git a/internal/event/syslog.go b/internal/event/syslog.go
new file mode 100644
index 0000000..df36d4d
--- /dev/null
+++ b/internal/event/syslog.go
@@ -0,0 +1,120 @@
+package event
+
+import (
+	"net"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/rs/zerolog/log"
+)
+
+// Server menerima syslog via UDP dan meneruskannya ke Bus sebagai Event.
+//
+// Catatan beban OLT: server ini PASIF. OLT yang mengirim saat ada kejadian;
+// tidak ada satu pun paket yang dikirim ke OLT dari jalur ini. Satu-satunya
+// "beban" di OLT adalah 1 baris config: arahkan syslog ke IP:port ini.
+type Server struct {
+	conn   *net.UDPConn
+	bus    *Bus
+	mapper *Mapper
+	port   int
+
+	dropped atomic.Uint64 // datagram dibuang karena antrian penuh
+	unknown atomic.Uint64 // baris tak dikenal (untuk kalibrasi)
+}
+
+// NewServer buat server syslog. bus dan mapper wajib non-nil.
+func NewServer(bus *Bus, mapper *Mapper, port int) *Server {
+	return &Server{bus: bus, mapper: mapper, port: port}
+}
+
+// Serve blokir sampai ctx selesai. Panggil sebagai goroutine.
+func (s *Server) Serve(stop <-chan struct{}) error {
+	addr, err := net.ResolveUDPAddr("udp", "0.0.0.0:"+itoa(s.port))
+	if err != nil {
+		return err
+	}
+	conn, err := net.ListenUDP("udp", addr)
+	if err != nil {
+		return err
+	}
+	s.conn = conn
+	defer conn.Close()
+
+	// Buffer socket besar agar burst trap (mass-down) tidak terbuang di kernel.
+	_ = conn.SetReadBuffer(4 << 20)
+
+	log.Info().Int("port", s.port).Msg("Syslog server dengar (event-driven, nol beban polling)")
+
+	buf := make([]byte, 65535)
+	for {
+		select {
+		case <-stop:
+			return nil
+		default:
+		}
+		_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+		n, src, err := conn.ReadFromUDP(buf)
+		if err != nil {
+			if ne, ok := err.(net.Error); ok && ne.Timeout() {
+				continue
+			}
+			log.Warn().Err(err).Msg("Syslog read error")
+			continue
+		}
+		s.handle(buf[:n], src)
+	}
+}
+
+func (s *Server) handle(data []byte, src *net.UDPAddr) {
+	line := strings.TrimSpace(string(data))
+	if line == "" {
+		return
+	}
+	// Syslog bisa multi-baris; proses per baris.
+	for _, l := range strings.Split(line, "\n") {
+		l = strings.TrimSpace(l)
+		if l == "" {
+			continue
+		}
+		if len(l) > 500 {
+			l = l[:500]
+		}
+		p, ok := ParseLine(l)
+		if !ok {
+			s.unknown.Add(1)
+			log.Debug().Str("line", l).Msg("Syslog tak dikenal (kalibrasi pola?)")
+			continue
+		}
+		srcIP := ""
+		if src != nil {
+			srcIP = src.IP.String()
+		}
+		oltID, ok := s.mapper.Resolve(srcIP)
+		if !ok {
+			log.Warn().Str("src", srcIP).Str("line", l).
+				Msg("Syslog dari IP tak dikenal — daftarkan di event.syslog.sources atau sebagai OLT")
+			continue
+		}
+		ev := Event{
+			OLTID:      oltID,
+			Board:      p.Board,
+			Pon:        p.Pon,
+			OnuID:      p.OnuID,
+			Kind:       p.Kind,
+			Cause:      p.Cause,
+			Raw:        l,
+			SourceIP:   srcIP,
+			ReceivedAt: time.Now(),
+		}
+		if !s.bus.Publish(ev) {
+			s.dropped.Add(1)
+		}
+	}
+}
+
+// Stats untuk endpoint monitoring.
+func (s *Server) Stats() (dropped, unknown uint64) {
+	return s.dropped.Load(), s.unknown.Load()
+}
diff --git a/internal/handler/event_handler.go b/internal/handler/event_handler.go
new file mode 100644
index 0000000..c718056
--- /dev/null
+++ b/internal/handler/event_handler.go
@@ -0,0 +1,127 @@
+package handler
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/rs/zerolog/log"
+
+	"olt-monitor/internal/cache"
+)
+
+// EventHandler: akses event up/down yang masuk via syslog + alert.
+//
+//  GET /api/v1/events/stream        SSE — dorong event & alert realtime
+//  GET /api/v1/events/recent?limit= event log terakhir (JSON)
+//  GET /api/v1/alerts?limit=        alert down yang lolos anti-spam (JSON)
+type EventHandler struct {
+	cache *cache.RedisCache
+}
+
+func NewEventHandler(c *cache.RedisCache) *EventHandler {
+	return &EventHandler{cache: c}
+}
+
+// Stream: Server-Sent Events. Tanpa dependency websocket — stdlib cukup.
+func (h *EventHandler) Stream(w http.ResponseWriter, r *http.Request) {
+	if h.cache == nil {
+		InternalError(w, "cache tidak tersedia")
+		return
+	}
+	w.Header().Set("Content-Type", "text/event-stream")
+	w.Header().Set("Cache-Control", "no-cache")
+	w.Header().Set("Connection", "keep-alive")
+	w.Header().Set("X-Accel-Buffering", "no")
+	flusher, ok := w.(http.Flusher)
+	if !ok {
+		InternalError(w, "streaming tidak didukung")
+		return
+	}
+
+	ch, closeSub := h.cache.SubscribeEvents(r.Context())
+	defer closeSub()
+	ach, closeAlert := h.cache.SubscribeAlerts(r.Context())
+	defer closeAlert()
+
+	// Kirim status awal agar client tahu stream hidup.
+	fmt.Fprintf(w, "event: hello\ndata: {\"ok\":true}\n\n")
+	flusher.Flush()
+
+	heartbeat := time.NewTicker(25 * time.Second)
+	defer heartbeat.Stop()
+
+	for {
+		select {
+		case <-r.Context().Done():
+			return
+		case msg, ok := <-ch:
+			if !ok {
+				return
+			}
+			fmt.Fprintf(w, "event: onu\ndata: %s\n\n", msg)
+			flusher.Flush()
+		case msg, ok := <-ach:
+			if !ok {
+				return
+			}
+			fmt.Fprintf(w, "event: alert\ndata: %s\n\n", msg)
+			flusher.Flush()
+		case <-heartbeat.C:
+			fmt.Fprintf(w, ": ping\n\n")
+			flusher.Flush()
+		}
+	}
+}
+
+// Alerts: alert down yang lolos anti-spam. Untuk ditampilkan frontend.
+func (h *EventHandler) Alerts(w http.ResponseWriter, r *http.Request) {
+	if h.cache == nil {
+		InternalError(w, "cache tidak tersedia")
+		return
+	}
+	limit := 50
+	if q := r.URL.Query().Get("limit"); q != "" {
+		if n, err := strconv.Atoi(q); err == nil && n > 0 {
+			limit = n
+		}
+	}
+	raw, err := h.cache.RecentAlerts(r.Context(), limit)
+	if err != nil {
+		log.Error().Err(err).Msg("Gagal baca alert log")
+		InternalError(w, "gagal baca alert")
+		return
+	}
+	out := make([]json.RawMessage, 0, len(raw))
+	for _, b := range raw {
