+			defer cl.Close()
+			ifIndex := snmp.CalculateIfIndexDefault(ev.Board, ev.Pon)
+			oid := snmp.BuildONUOID(snmp.OIDONUStatus, ifIndex, ev.OnuID, "")
+			st, err := cl.GetInt(oid)
+			if err != nil {
