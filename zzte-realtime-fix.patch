+	}
+	eventBus.Subscribe(alertEngine.Handle)
+	alertEngine.Start()
+	defer alertEngine.Stop()
+	log.Info().Msg("Alert engine aktif (anti-spam: agregasi + cooldown, via /api/v1/alerts)")
